# ============================================
# A 股实时分析平台后端环境变量示例
# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# ============================================

# 数据库连接串
# 开发环境默认使用 SQLite（无需额外服务）
DATABASE_URL=sqlite:///./a_stock.db
AUTO_CREATE_TABLES=false
# 生产环境示例（PostgreSQL）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/a_stock

# 服务监听
HOST=127.0.0.1
PORT=8000
DEBUG=false

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 行情数据源优先级（逗号分隔，越靠前优先级越高）
# 可选: qmt / tencent / akshare / mock
MARKET_PROVIDERS=tencent,akshare

# 免费行情轮询间隔（秒）
QUOTE_POLL_INTERVAL=3

# 每只股票滚动窗口保存的分钟线数量
ROLLING_WINDOW_SIZE=300

# 信号冷却时间（秒）
SIGNAL_COOLDOWN_SECONDS=60

# 模拟成交允许的最大行情接收延迟（秒）
MAX_QUOTE_AGE_SECONDS=15

# QMT 行情（可选，正式实时行情）
QMT_API_KEY=YOUR_API_KEY
QMT_API_SECRET=YOUR_API_KEY

# 腾讯行情 API Key（可选，免费接口一般无需）
TENCENT_API_KEY=YOUR_API_KEY

# AKShare（免费，一般无需密钥）
AKSHARE_API_KEY=YOUR_API_KEY

# CORS 允许来源（默认只允许本地前端）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 请求频率限制（每分钟最大请求数，0 表示不限制）
RATE_LIMIT_PER_MINUTE=300

# 单连接 WebSocket 最大订阅数量
WS_MAX_SUBSCRIPTIONS=200
