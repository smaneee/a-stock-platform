# ============================================
# A 股实时分析平台后端环境变量示例
# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# ============================================

# 数据库连接串
# 开发环境默认使用 SQLite（无需额外服务）
DATABASE_URL=sqlite:///./a_stock.db
AUTO_CREATE_TABLES=false
# 测试/CI/managed E2E 模式：强制全部行情改用 mock 数据源。
# 只能在离线测试中开启；真实运行请保持 false，否则会拿到随机价格。
E2E_USE_MOCK=false
# 生产环境示例（PostgreSQL）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/a_stock

# 服务监听
HOST=127.0.0.1
PORT=8000
DEBUG=false

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 行情数据源优先级（逗号分隔，越靠前优先级越高）
# 实时行情数据源优先级，可选: tdx（通达信）/ eastmoney（东方财富）/ tencent / akshare / qmt / mock
# tdx 走二进制 TCP 协议（默认端口 7709），延迟远低于 HTTP 轮询且不限流，故排在最前；
# 它不支持北交所代码，这类请求会自动回退到 eastmoney。
# eastmoney 与 akshare 的历史接口同源（东财 kline），管理器不会对同一上游重复请求
MARKET_PROVIDERS=tdx,eastmoney,tencent,akshare

# 免费行情轮询间隔（秒）
QUOTE_POLL_INTERVAL=3

# 每只股票滚动窗口保存的分钟线数量
ROLLING_WINDOW_SIZE=300

# 信号冷却时间（秒）
SIGNAL_COOLDOWN_SECONDS=60

# 模拟成交允许的最大行情接收延迟（秒）
MAX_QUOTE_AGE_SECONDS=15

# QMT 行情与实盘（可选）。实盘默认关闭；userdata_mini 路径和账号只写本机 .env。
REAL_TRADING_ENABLED=false
QMT_USERDATA_PATH=C:\券商QMT\userdata_mini
QMT_ACCOUNT_ID=YOUR_ACCOUNT_ID
QMT_ACCOUNT_TYPE=STOCK
QMT_CALL_TIMEOUT_SECONDS=10
# 至少 32 个随机字符；只保存在本机 .env，前端每次会话手动输入。
LIVE_TRADING_API_TOKEN=
# 实盘委托提交后的只读自动对账轮询间隔；不会自动补单/撤单。
LIVE_RECONCILE_INTERVAL_SECONDS=30

# 腾讯行情 API Key（可选，免费接口一般无需）
TENCENT_API_KEY=YOUR_API_KEY

# AKShare（免费，一般无需密钥）
AKSHARE_API_KEY=YOUR_API_KEY

# 股票池主数据源（逗号分隔，依次尝试；全部失败时同步返回 503）
# 东方财富提供当前全市场名单（含所属行业），BaoStock 提供历史时点成员与停牌状态，
# AKShare 作为当前全市场兜底。
# 历史日期缺少北交所覆盖时会明确失败，不会用当前名单伪造历史快照。
UNIVERSE_PROVIDERS=eastmoney,baostock,akshare
# 东方财富股票池：沪深京 A 股 60 页并发拉取，实测 3~10 秒
EASTMONEY_UNIVERSE_TIMEOUT_SECONDS=90
# BaoStock 全市场拉取实测约 70~210 秒（逐行读取 7382 + 8950 行是主要耗时），
# 给足余量，否则慢但成功的拉取会被当成超时丢弃。
BAOSTOCK_UNIVERSE_TIMEOUT_SECONDS=300
# AKShare BJ 子源分 18 页拉取，实测 12~20 秒
BAOSTOCK_BJ_SUPPLEMENT_TIMEOUT_SECONDS=60
AKSHARE_UNIVERSE_TIMEOUT_SECONDS=30
# 股票池同步重试次数（每个 provider 内最多 max_retries+1 次尝试）
UNIVERSE_MAX_RETRIES=2
# 重试退避基数（毫秒）：第 n 次重试等待 base * 2^n，并叠加 0~25% 抖动
UNIVERSE_BACKOFF_BASE_MS=50

# 全市场历史入库的后台并发（过高会触发免费数据源限流）
HISTORY_INGEST_MAX_CONCURRENCY=4

# 模拟盘风控阈值（比例均为小数，0.20 = 20%）
# 只影响模拟盘与回测的风控判定，不改变券商柜台侧风控；修改后需重启后端。
RISK_MAX_POSITION_PER_SYMBOL=0.20
RISK_MAX_TOTAL_POSITION=0.80
RISK_MAX_DAILY_LOSS=0.03
RISK_MAX_TOTAL_DRAWDOWN=0.10
RISK_MIN_COMMISSION=5.0
RISK_COMMISSION_RATE=0.0003
RISK_STAMP_TAX_RATE=0.0005

# 每日流水线自动调度（可选，默认关闭）
# 开启后每个 A 股交易日按下面的北京时间自动创建当日流水线任务（非交易日跳过）。
# 只创建研究与模拟任务，永不下真实订单；自动执行模拟调仓必须先指定模拟账户。
DAILY_PIPELINE_AUTO_ENABLED=false
DAILY_PIPELINE_AUTO_HOUR=15
DAILY_PIPELINE_AUTO_MINUTE=35
# 0 表示不联动模拟账户（只生成选股结果）
DAILY_PIPELINE_AUTO_PAPER_ACCOUNT_ID=0
DAILY_PIPELINE_AUTO_EXECUTE_PAPER=false
DAILY_PIPELINE_AUTO_LOOKBACK_DAYS=365

# CORS 允许来源（默认只允许本地前端；逗号分隔）
# 开发期可用 Vite 代理绕开，无需 CORS；仅前后端分离部署时此配置生效
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 请求频率限制（每分钟最大请求数，0 表示不限制）
RATE_LIMIT_PER_MINUTE=300

# 单连接 WebSocket 最大订阅数量
WS_MAX_SUBSCRIPTIONS=200
